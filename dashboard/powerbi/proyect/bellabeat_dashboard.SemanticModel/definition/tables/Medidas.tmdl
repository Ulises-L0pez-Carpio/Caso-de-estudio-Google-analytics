table Medidas
	lineageTag: 642948c4-bb91-43c5-873e-161c74c692bf

	measure Usuarios = DISTINCTCOUNT(bellabeat_analysis_dataset[user_id])
		formatString: 0
		lineageTag: 4244cd21-4bf0-414d-86f7-f87d86a4265d

	measure 'Registros diarios' = COUNTROWS(bellabeat_analysis_dataset)
		formatString: 0
		lineageTag: 7c20fac4-aa47-4c2b-9882-8518bcf50576

	measure 'Pasos promedio' = AVERAGE(bellabeat_analysis_dataset[total_steps])
		formatString: 0
		lineageTag: d5f5327d-522c-4dc6-91c0-115be40d0b3a

	measure 'Calorías promedio' = AVERAGE(bellabeat_analysis_dataset[calories])
		lineageTag: f43cac37-c721-4eba-9a73-ba11acde172a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Minutos activos promedio' = AVERAGE(bellabeat_analysis_dataset[active_minutes])
		formatString: 0.00
		lineageTag: d2471da9-f23a-41b5-8d38-4e9bb2c2ec3f

	measure 'Minutos sedentarios promedio' = AVERAGE(bellabeat_analysis_dataset[sedentary_minutes])
		formatString: 0.00
		lineageTag: 7c104bb4-47ff-48b5-8ffe-4970d824d14b

	measure 'Horas de sueño promedio' =
			
			AVERAGEX(
			    FILTER(
			        bellabeat_analysis_dataset,
			        NOT(ISBLANK(bellabeat_analysis_dataset[sleep_hours]))
			    ),
			    IF(
			        bellabeat_analysis_dataset[sleep_hours] > 24,
			        bellabeat_analysis_dataset[sleep_hours] / 60,
			        bellabeat_analysis_dataset[sleep_hours]
			    )
			)
		formatString: 0.00
		lineageTag: ac16561f-75a9-424c-8279-1158fd605419

	measure 'Eficiencia de sueño promedio' =
			
			VAR AvgEfficiency =
			    AVERAGE(bellabeat_analysis_dataset[sleep_efficiency])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(AvgEfficiency), BLANK(),
			    AvgEfficiency > 100, DIVIDE(AvgEfficiency, 10000),
			    AvgEfficiency > 1, DIVIDE(AvgEfficiency, 100),
			    AvgEfficiency
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b888a872-d27b-4396-8dc8-79a04513de83

	measure '% días 10k pasos' =
			
			VAR DiasValidos =
			    COUNTROWS(
			        FILTER(
			            bellabeat_analysis_dataset,
			            NOT(ISBLANK(bellabeat_analysis_dataset[total_steps]))
			        )
			    )
			VAR Dias10k =
			    COUNTROWS(
			        FILTER(
			            bellabeat_analysis_dataset,
			            NOT(ISBLANK(bellabeat_analysis_dataset[total_steps]))
			                && bellabeat_analysis_dataset[total_steps] >= 10000
			        )
			    )
			RETURN
			DIVIDE(Dias10k, DiasValidos)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d2a63afc-f924-455d-bfe3-1086cf481c84

	measure 'Usuarios con sueño' =
			
			CALCULATE(
			    DISTINCTCOUNT(bellabeat_analysis_dataset[user_id]),
			    NOT(ISBLANK(bellabeat_analysis_dataset[sleep_hours]))
			)
		formatString: 0
		lineageTag: 092d5c9c-7c13-4ed8-b7d2-0685e0b108ae

	measure 'Registros diarios texto' =
			
			FORMAT(
			    [Registros diarios],
			    "#,##0"
			)
		lineageTag: e5718eb6-e18f-4bda-bcb4-01f2d1377e36

	measure 'Pasos prom. segmento' =
			
			AVERAGE(user_segments[avg_steps])
		lineageTag: 59752ea0-9c54-4c4b-b790-dfd105f11f74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min. activos prom. segmento' =
			
			AVERAGE(user_segments[avg_active_minutes])
		lineageTag: 4605031f-de8b-4a7e-9f54-9d9402439da7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sueño prom. segmento' =
			
			AVERAGEX(
			    user_segments,
			    IF(
			        user_segments[avg_sleep_hours] > 24,
			        user_segments[avg_sleep_hours] / 60,
			        user_segments[avg_sleep_hours]
			    )
			)
		lineageTag: 55d55d25-1c61-4b40-9d82-5e0344a0209d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% días 10k segmento' =
			
			AVERAGEX(
			    user_segments,
			    VAR PctValue = user_segments[pct_days_meeting_10000_steps]
			    RETURN
			        SWITCH(
			            TRUE(),
			            ISBLANK(PctValue), BLANK(),
			            PctValue > 1, PctValue / 100,
			            PctValue
			        )
			)
		lineageTag: 2e2ac3b4-7957-4c54-9258-eabc619e755e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Nombre
		lineageTag: 38990fd8-3328-4dca-b366-37c5820fea6c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nombre]

		annotation SummarizationSetBy = Automatic

	partition Medidas = calculated
		mode: import
		source =
				DATATABLE(
				    "Nombre", STRING,
				    {
				        {"Medidas DAX"}
				    }
				)

	annotation PBI_Id = cf73e1d302314a4b8f91d9a19cd6f50c

